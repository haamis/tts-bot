default_tts: en_US-lessac-medium
# NOTE: voice config only — all limits (MAX_CHARS, MAX_MEDIA_SECONDS, ...)
# live in .env. A stale `max_chars:` key here is ignored.
# Extra text appended (after a newline) to every !generate prompt.
generate_prompt_suffix: Use a maximum of 4500 characters.
ffmpeg_path: ffmpeg
rvc_root: rvc_infer
# Per-voice options, grouped by provider. Speeds are per-mechanism (they
# behave differently, so one number can't serve all): kokoro speed = its
# native param, cloud speed = ffmpeg atempo post-processing, piper speed =
# --length-scale. 1.0 = normal. A plain `speed:` key still works and sets
# all three (legacy), as do the old flat keys (tts, rvc_model, ...).
voices:
  snake:
    kokoro: {voice: am_adam, speed: 0.9}
    cloud: {voice: flux-donovan-en, speed: 1.0}
    piper: {voice: en_US-ryan-medium, speed: 0.7}
    # f0_method: "pm" is ~2x faster on CPU (fine for clean TTS input);
    # "rmvpe" is more accurate for real-world/noisy audio (e.g. !rvc on songs)
    rvc: {model: /home/haama/TTS-bot/rvc_models/snake/SSNAKE.pth,
          index: /home/haama/TTS-bot/rvc_models/snake/added_IVF967_Flat_nprobe_1_SSNAKE_v2.index,
          pitch: -5, index_rate: 0.85, f0_method: rmvpe, speaker_id: 0,
          reference_clip: /home/haama/TTS-bot/out/tts_compare/ref_snake_16k.wav}
  trump:
    kokoro: {voice: am_eric, speed: 0.9}
    cloud: {voice: flux-donovan-en, speed: 1.0}
    piper: {voice: en_US-ryan-medium, speed: 0.7}
