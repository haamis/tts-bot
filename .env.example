# Discord bot token (required)
DISCORD_TOKEN=

# Command prefix (default: !)
COMMAND_PREFIX=!

# Optional: Character cap for !speak/!generate text (default: 500).
# Voices and their tunables live in config/voices.yaml; all limits live here.
# MAX_CHARS=500

# Optional: Kokoro donor voice for characters without their own
# `kokoro_voice:` in config/voices.yaml (default: af_heart). RVC erases
# donor identity, so one prosody donor serves all voices. Empty disables
# the Kokoro tier (chain becomes cloud -> Piper).
# KOKORO_VOICE=af_heart

# Optional: guild IDs for instant slash command sync (comma-separated)
# GUILD_IDS=123456789,987654321

# Optional: FFmpeg path if not in PATH
# FFMPEG_PATH=ffmpeg

# Optional: Dry run mode - generate audio files without connecting to Discord
# BOT_DRY_RUN=0

# Optional: Seconds the bot stays in a voice channel after playback before
# auto-disconnecting (default: 3600 = 1 hour). 0 disables the idle timer —
# the bot then stays connected until the last human leaves.
# IDLE_TIMEOUT=3600

# Optional: Keep a persistent RVC worker process with models preloaded.
# Much faster per conversion (~14s saved per turn) at the cost of ~2GB
# resident RAM. Set to 0 to fall back to one-shot subprocess inference.
# RVC_WORKER=1

# Optional: Recycle the RVC worker when its RSS exceeds this (MB) — bounds
# memory growth from glibc arena fragmentation after large !rvc jobs.
# Recycling costs a ~14s model reload. 0 disables recycling.
# RVC_WORKER_MAX_RSS_MB=2500

# Optional: OpenRouter key for !generate (LLM writes text for the TTS).
# Without a key, !generate replies with a setup hint. The same key enables
# cloud TTS (deepgram/flux-tts:free) with local Piper fallback.
# OPENROUTER_API_KEY=

# Optional: Cloud TTS model and settings. "auto" (default) uses cloud TTS
# when OPENROUTER_API_KEY is set, falling back to local Piper on rate-limit
# or error. Set to "local" to always use Piper.
# TTS_PROVIDER=auto
# OPENROUTER_TTS_MODEL=deepgram/flux-tts:free
# OPENROUTER_TTS_SAMPLE_RATE=24000
# Seconds the cloud provider is skipped after a rate limit before retrying.
# CLOUD_TTS_COOLDOWN=300

# Optional: Maximum media length (seconds) accepted by !rvc.
# MAX_MEDIA_SECONDS=180

# Optional: Multi-voice !rvc — cosine-distance cut for collapsing detected
# speakers (calibrated default 0.35). Fewer speakers than requested voices
# is fine; 0 disables collapsing and forces one cluster per requested voice
# (you own speaker-count mismatches).
# RVC_DIARIZE_THRESHOLD=0.35

# Optional: Multi-voice !rvc diarization engine. "auto" (default) uses
# pyannote when HF_TOKEN is set (falling back to the built-in local engine
# on any failure), "local" always uses the built-in wav2vec2+RMVPE stack,
# "pyannote" forces pyannote (errors surface to the user).
# RVC_DIARIZE_ENGINE=auto

# Optional: HuggingFace token for the gated pyannote models. One-time setup:
# 1. accept conditions at https://hf.co/pyannote/segmentation-3.0
# 2. accept conditions at https://hf.co/pyannote/speaker-diarization-3.1
# 3. create a read token at https://hf.co/settings/tokens
# HF_TOKEN=

# Optional: Torch device for the pyannote diarization engine. "auto" uses
# CUDA when available. (The local diarization engine and the RVC worker
# still pick their own devices.)
# RVC_DEVICE=auto

# Optional: Remote GPU worker server (Phase 1, thin-client side). Empty
# (default) = local CPU worker. Set to the desktop's base URL to convert
# remotely with automatic local fallback ("slow path", flagged in status)
# when the server is unreachable:
# RVC_GPU_SERVER_URL=http://gpu-box:8001
# Shared bearer token (must match the server's RVC_GPU_SERVER_TOKEN).
# Empty = no auth (fine on a trusted home LAN).
# RVC_GPU_SERVER_TOKEN=
# Per-request HTTP timeout in seconds (GPU converts are fast; this mirrors
# the local worker's generous budget for worst-case !rvc jobs).
# RVC_GPU_SERVER_TIMEOUT=900

# --- Desktop GPU-server side only (evaluated by rvc-gpu-server/server.py,
# not by the bot): RVC_GPU_SERVER_HOST (default 0.0.0.0),
# RVC_GPU_SERVER_PORT (default 8001), RVC_GPU_SERVER_TOKEN,
# RVC_MODEL_ROOT (flat dir of .pth/.index files, used when the client's
# absolute model paths don't exist on the desktop), RVC_WORKER_ROOT,
# RVC_WORKER_THREADS, RVC_WORKER_MAX_RSS_MB, RVC_DEVICE. ---

# Optional: OpenRouter model id. "openrouter/free" routes to whatever free
# models are currently available. See https://openrouter.ai/openrouter/free
# OPENROUTER_MODEL=openrouter/free

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO