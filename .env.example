# Discord bot token (required)
DISCORD_TOKEN=

# Command prefix (default: !)
COMMAND_PREFIX=!

# Optional: guild IDs for instant slash command sync (comma-separated)
# GUILD_IDS=123456789,987654321

# Optional: FFmpeg path if not in PATH
# FFMPEG_PATH=ffmpeg

# Optional: Dry run mode - generate audio files without connecting to Discord
# BOT_DRY_RUN=0

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO